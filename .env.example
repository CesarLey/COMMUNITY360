# Copia este archivo a .env (que NO se sube al repositorio) y completa los valores.
TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
TURSO_AUTH_TOKEN=pega_aqui_el_token
# Ruta del archivo .json de la cuenta de servicio de Firebase (guárdalo FUERA de la carpeta del proyecto)
FIREBASE_SERVICE_ACCOUNT_FILE=C:/Users/tu_usuario/Desktop/firebase-clave.json

# Servidor y Autenticación (Fase 3)
PORT=3000
JWT_SECRET=tu_clave_secreta_jwt_muy_segura

# Mapa de calor geográfico (MapTiler Cloud: https://cloud.maptiler.com/account/keys/)
MAPTILER_API_KEY=pega_aqui_tu_maptiler_api_key
